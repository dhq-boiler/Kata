<Window x:Class="Kata.App.Dialogs.PullUpMemberDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Kata.App.Services"
        xmlns:loc="clr-namespace:Kata.App.Localization"
        Title="{x:Static loc:Strings.PullUpMember_Title}"
        Height="560" Width="520"
        Background="#252526"
        Foreground="#e0e0e0"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/Icons/kata-transparent.ico"
        Style="{StaticResource ChromedWindow}"
        svc:WindowChromeHelper.IsAttached="True"
        ShowInTaskbar="False">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" />

        <TextBlock Grid.Row="1" Text="{x:Static loc:Strings.PullUpMember_FromSubclass}" FontSize="11" Foreground="#888" />
        <TextBlock Grid.Row="2" x:Name="SubclassText" FontFamily="Consolas" FontSize="13" Margin="0,2,0,10" />

        <TextBlock Grid.Row="3" Text="{x:Static loc:Strings.PullUpMember_UpToParent}" FontSize="11" Foreground="#888" />
        <TextBlock Grid.Row="4" x:Name="ParentText" FontFamily="Consolas" FontSize="13" Margin="0,2,0,12" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,2,0,4">
            <Button Content="{x:Static loc:Strings.Dialog_SelectAll}" Padding="8,2" FontSize="11" Click="OnSelectAllClick" />
            <Button Content="{x:Static loc:Strings.Toolbar_Clear}" Padding="8,2" FontSize="11" Margin="6,0,0,0" Click="OnSelectNoneClick" />
            <TextBlock x:Name="SelectionCountText" Foreground="#a0a0a0" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <ListBox Grid.Row="6"
                 x:Name="MembersList"
                 Background="#1e1e1e"
                 Foreground="#e0e0e0"
                 BorderBrush="#3f3f46"
                 SelectionMode="Extended">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Foreground="#e0e0e0"
                              Padding="4,2">
                        <TextBlock Text="{Binding DisplayLine}" FontFamily="Consolas" FontSize="12" />
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{x:Static loc:Strings.Common_Cancel}" Width="90" Height="30" Margin="0,0,8,0" Click="OnCancelClick" />
            <Button Content="{x:Static loc:Strings.Dialog_Preview}" x:Name="OkButton" Width="90" Height="30" IsDefault="True" Click="OnOkClick" />
        </StackPanel>
    </Grid>
</Window>
