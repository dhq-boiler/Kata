<Window x:Class="Kata.App.Dialogs.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Kata.App.Services"
        xmlns:loc="clr-namespace:Kata.App.Localization"
        Title="{x:Static loc:Strings.Rename_Title}"
        Height="220" Width="440"
        Background="#252526"
        Foreground="#e0e0e0"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/Icons/kata-transparent.ico"
        Style="{StaticResource ChromedWindow}"
        svc:WindowChromeHelper.IsAttached="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static loc:Strings.Rename_CurrentName}" FontSize="11" Foreground="#888" />
        <TextBlock Grid.Row="1" x:Name="CurrentNameText" FontFamily="Consolas" FontSize="14" Margin="0,2,0,12" />

        <TextBlock Grid.Row="2" Text="{x:Static loc:Strings.Dialog_NewName}" FontSize="11" Foreground="#888" />
        <TextBox Grid.Row="3"
                 x:Name="NewNameBox"
                 FontFamily="Consolas"
                 FontSize="14"
                 Padding="6,4"
                 Background="#1e1e1e"
                 Foreground="White"
                 BorderBrush="#3f3f46"
                 KeyDown="OnNewNameKeyDown" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{x:Static loc:Strings.Common_Cancel}" Width="80" Height="28" Margin="0,0,8,0" Click="OnCancelClick" />
            <Button Content="{x:Static loc:Strings.Dialog_Preview}" x:Name="OkButton" Width="80" Height="28" IsDefault="True" Click="OnOkClick" />
        </StackPanel>
    </Grid>
</Window>
