<Window x:Class="Kata.App.Dialogs.AiRequestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Kata.App.Services"
        xmlns:loc="clr-namespace:Kata.App.Localization"
        Title="{x:Static loc:Strings.AiRequest_Title}"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/Icons/kata-transparent.ico"
        Style="{StaticResource ChromedWindow}"
        svc:WindowChromeHelper.IsAttached="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#1e1e1e"
        Foreground="#e0e0e0">
    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="HeadlineText"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="#e0e0e0"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <TextBlock Grid.Row="1"
                   x:Name="SubtitleText"
                   FontSize="11"
                   Foreground="#a0a0a0"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <ProgressBar Grid.Row="2"
                     IsIndeterminate="True"
                     Height="6"
                     Foreground="#4a9eff"
                     Background="#3a3d5e"
                     BorderBrush="Transparent"
                     Margin="0,0,0,14" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <TextBlock x:Name="ElapsedText"
                       FontSize="11"
                       Foreground="#7a8494"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"
                       MinWidth="80" />
            <Button x:Name="CancelButton"
                    Content="{x:Static loc:Strings.Common_Cancel}"
                    Padding="14,4"
                    MinWidth="88"
                    Click="OnCancelClick"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
