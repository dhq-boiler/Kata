<Window x:Class="Kata.App.Dialogs.AddGhostTypeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Kata.App.Services"
        xmlns:loc="clr-namespace:Kata.App.Localization"
        Title="{x:Static loc:Strings.AddGhostType_Title}"
        Height="340" Width="500"
        Background="#252526"
        Foreground="#e0e0e0"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/Icons/kata-transparent.ico"
        Style="{StaticResource ChromedWindow}"
        svc:WindowChromeHelper.IsAttached="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static loc:Strings.AddGhostType_Kind}" FontSize="11" Foreground="#888" />
        <ComboBox Grid.Row="1"
                  x:Name="KindCombo"
                  FontSize="12"
                  Margin="0,2,0,12"
                  Background="#1e1e1e"
                  Foreground="White"
                  BorderBrush="#3f3f46">
            <!-- C# のキーワード。表示 = 中身なのでローカライズしない -->
            <ComboBoxItem Content="Class" IsSelected="True" />
            <ComboBoxItem Content="Interface" />
            <ComboBoxItem Content="Struct" />
            <ComboBoxItem Content="Record" />
            <ComboBoxItem Content="Enum" />
        </ComboBox>

        <TextBlock Grid.Row="2" Text="{x:Static loc:Strings.AddGhostType_Namespace}" FontSize="11" Foreground="#888" />
        <TextBox Grid.Row="3"
                 x:Name="NamespaceBox"
                 FontFamily="Consolas"
                 FontSize="13"
                 Padding="6,4"
                 Background="#1e1e1e"
                 Foreground="White"
                 BorderBrush="#3f3f46"
                 Margin="0,2,0,12" />

        <TextBlock Grid.Row="4" Text="{x:Static loc:Strings.AddGhostType_TypeName}" FontSize="11" Foreground="#888" />
        <TextBox Grid.Row="5"
                 x:Name="TypeNameBox"
                 FontFamily="Consolas"
                 FontSize="14"
                 Padding="6,4"
                 Background="#1e1e1e"
                 Foreground="White"
                 BorderBrush="#3f3f46"
                 Margin="0,2,0,4" />

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{x:Static loc:Strings.Common_Cancel}" Width="90" Height="30" Margin="0,0,8,0" Click="OnCancelClick" />
            <Button Content="{x:Static loc:Strings.Dialog_Preview}" x:Name="OkButton" Width="90" Height="30" IsDefault="True" Click="OnOkClick" />
        </StackPanel>
    </Grid>
</Window>
