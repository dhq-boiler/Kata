<Window x:Class="Kata.App.Dialogs.DiffPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Kata.App.Services"
        xmlns:loc="clr-namespace:Kata.App.Localization"
        Title="{x:Static loc:Strings.DiffPreview_Title}"
        Height="700" Width="1200"
        Background="#1e1e1e"
        Foreground="#e0e0e0"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/Icons/kata-transparent.ico">


    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="SummaryText" FontSize="14" Foreground="White" Margin="0,0,0,8" />
        <TextBlock Grid.Row="1" x:Name="RationaleText" FontSize="11" FontStyle="Italic" Foreground="#a0a0a0" Margin="0,0,0,8" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="FileList"
                     Grid.Column="0"
                     Background="#252526"
                     Foreground="#e0e0e0"
                     BorderBrush="#3f3f46"
                     SelectionChanged="OnFileSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2">
                            <TextBlock Text="{Binding DisplayName}" FontFamily="Consolas" FontSize="12" />
                            <TextBlock Text="{Binding SubPath}" FontSize="10" Foreground="#888" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Column="1" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{x:Static loc:Strings.DiffPreview_UnifiedDiff}" FontSize="11" Foreground="#c0c0c0" Margin="0,0,0,4" />
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Background="#1e1e1e"
                              BorderBrush="#3f3f46"
                              BorderThickness="1">
                    <ItemsControl x:Name="DiffList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding RowBackground}" Padding="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding OldLine}"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Foreground="#666"
                                                   TextAlignment="Right"
                                                   Padding="2,0,4,0" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding NewLine}"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Foreground="#666"
                                                   TextAlignment="Right"
                                                   Padding="2,0,4,0" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Marker}"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Foreground="{Binding MarkerBrush}"
                                                   TextAlignment="Center" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Text}"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   Foreground="{Binding ForegroundBrush}"
                                                   Padding="4,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{x:Static loc:Strings.DiffPreview_ExportInstruction}" Width="150" Height="30" Margin="0,0,8,0" Click="OnExportInstructionClick" />
            <Button Content="{x:Static loc:Strings.DiffPreview_Reject}" Width="90" Height="30" Margin="0,0,8,0" Click="OnRejectClick" />
            <Button Content="{x:Static loc:Strings.DiffPreview_Apply}" x:Name="ApplyButton" Width="90" Height="30" IsDefault="True" Click="OnApplyClick" />
        </StackPanel>
    </Grid>
</Window>
